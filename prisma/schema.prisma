datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

model Log {
  id        String   @default(uuid())
  timestamp DateTime @default(now())
  category  String   
  rawText   String
  payload   Json     
  
  @@id([id, timestamp])
  @@index([timestamp(sort: Desc)])
}
