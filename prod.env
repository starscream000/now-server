# Credentials
POSTGRES_USER=myuser_prod
POSTGRES_PASSWORD=mypassword_prod
POSTGRES_DB=now_db_prod

# App Config
NODE_ENV=production

# CRITICAL: INTERNAL CONNECTION STRING
# Uses the service name "database" and internal port "5432"
DATABASE_URL=postgresql://myuser_prod:mypassword_prod@database:5432/now_db_prod?schema=public